{
	"id": "duotone-portrait",
	"name": "Duotone Portrait",
	"version": 1,
	"aspectRatios": ["4:5"],
	"fonts": ["Arial", "Georgia", "Arial Narrow"],
	"canvas": {
		"width": 1080,
		"height": 1350,
		"background": {
			"kind": "gradient",
			"color": "#0d0d1a",
			"opacity": 1,
			"gradient": {
				"type": "linear",
				"angle": 135,
				"stops": [
					{ "color": "#0d0d1a", "position": 0 },
					{ "color": "#1a0a30", "position": 0.5 },
					{ "color": "#0d0d1a", "position": 1 }
				]
			}
		}
	},
	"layers": [
		{
			"type": "image",
			"slot": "photo",
			"fit": "cover",
			"controls": {
				"exposure": 10,
				"contrast": 30,
				"saturation": 0,
				"temperature": 0,
				"tint": 0,
				"highlights": 15,
				"shadows": -5,
				"opacity": 100,
				"scale": 100,
				"rotation": 0
			},
			"effects": [
				{
					"id": "duotone-main",
					"type": "duotone",
					"preset": 0,
					"contrast": 25,
					"intensity": 100
				},
				{
					"id": "vignette-subtle",
					"type": "vignette",
					"radius": 80,
					"softness": 60,
					"darkness": 40
				}
			]
		},
		{
			"type": "text",
			"slot": "heading",
			"label": "Name",
			"default": "PORTRAIT",
			"font": "Georgia",
			"size": 88,
			"letterSpacing": 12,
			"color": "#e8d5b7",
			"x": 60,
			"y": 1130
		},
		{
			"type": "text",
			"slot": "tagline",
			"label": "Tagline",
			"default": "A STUDY IN CONTRAST",
			"font": "Arial Narrow",
			"size": 28,
			"letterSpacing": 6,
			"color": "#8888aa",
			"x": 64,
			"y": 1240
		}
	]
}
