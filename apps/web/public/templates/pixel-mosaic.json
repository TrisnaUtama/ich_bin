{
	"id": "pixel-mosaic",
	"name": "Pixel Mosaic",
	"version": 1,
	"aspectRatios": ["1:1"],
	"fonts": ["Courier New", "Impact", "Arial"],
	"canvas": {
		"width": 1080,
		"height": 1080,
		"background": {
			"kind": "solid",
			"color": "#0f0f1a",
			"opacity": 1,
			"gradient": {
				"type": "linear",
				"angle": 0,
				"stops": [
					{ "color": "#0f0f1a", "position": 0 },
					{ "color": "#1a1a30", "position": 1 }
				]
			}
		}
	},
	"layers": [
		{
			"type": "image",
			"slot": "photo",
			"fit": "cover",
			"controls": {
				"exposure": 5,
				"contrast": 25,
				"saturation": 40,
				"temperature": 0,
				"tint": 0,
				"highlights": 10,
				"shadows": 0,
				"opacity": 100,
				"scale": 100,
				"rotation": 0
			},
			"effects": [
				{
					"id": "pixelate-main",
					"type": "pixelate",
					"size": 35,
					"round": 0
				},
				{
					"id": "posterize-retro",
					"type": "posterize",
					"levels": 6,
					"gamma": 100,
					"intensity": 80
				}
			]
		},
		{
			"type": "text",
			"slot": "heading",
			"label": "Title",
			"default": "PIXEL",
			"font": "Courier New",
			"size": 140,
			"letterSpacing": 8,
			"color": "#00ff88",
			"x": 60,
			"y": 850,
			"weight": "bold"
		},
		{
			"type": "text",
			"slot": "subtitle",
			"label": "Subtitle",
			"default": "8-BIT DREAMS",
			"font": "Courier New",
			"size": 28,
			"letterSpacing": 10,
			"color": "#88aaff",
			"x": 64,
			"y": 1010
		}
	]
}
